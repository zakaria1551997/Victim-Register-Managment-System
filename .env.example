# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration (For Hospital LAN / Production Server)
# If PG_HOST is not set in AI Studio preview, the server automatically uses
# persistent embedded PostgreSQL 16 (PGlite) stored in ./data/pgdata
PG_HOST=""
PG_PORT="5432"
PG_DATABASE="hospital_injury_register"
PG_USER="postgres"
PG_PASSWORD=""
PG_SSL="false"

# Application Security & Storage
SESSION_SECRET="hospital-injury-register-hmac-secret-key-change-in-production"
STORAGE_DIR="./data/uploads"
BACKUP_DIR="./data/backups"
HOSPITAL_NAME_BN="শহীদ সৈয়দ নজরুল ইসলাম মেডিকেল কলেজ হাসপাতাল, কিশোরগঞ্জ"
